{
  "name": "alianca-skyline-bot",
  "version": "2.1.0",
  "description": "Bot oficial da Aliança Skyline para Discord - v2 com painéis",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.18.0",
    "@napi-rs/canvas": "^0.1.65",
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.2",
    "cookie-parser": "^1.4.6",
    "discord-player": "^7.2.0",
    "discord-voip": "^7.2.0",
    "discord.js": "^14.15.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.13",
    "mediaplex": "^1.0.0",
    "ms": "^2.1.3",
    "node-cron": "^3.0.3",
    "opusscript": "^0.0.8",
    "tweetnacl": "^1.0.3",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.12",
    "prism-media": "1.3.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "overrides": {
    "discord-api-types": "^0.38.0"
  }
}
