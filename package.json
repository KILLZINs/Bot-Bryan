{
  "name": "alianca-skyline-bot",
  "version": "2.1.0",
  "description": "Bot oficial da Aliança Skyline para Discord - v2 com painéis",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@prisma/client": "^5.7.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "ms": "^2.1.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
